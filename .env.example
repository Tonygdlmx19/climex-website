# Analítica opcional: ID de Google Analytics 4 / Google Ads (ej. G-XXXXXXX). Si está vacío no se carga nada.
NEXT_PUBLIC_GA_ID=
# URL pública del sitio (para sitemap, canonical y JSON-LD)
NEXT_PUBLIC_SITE_URL=https://climexsi.com

# --- Asistente de WhatsApp (API de WhatsApp Cloud de Meta) ---
# Si WA_TOKEN está vacío, el webhook funciona en modo prueba: no envía nada a Meta
# y devuelve en la respuesta los mensajes que habría enviado.
WA_TOKEN=
WA_PHONE_ID=
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# Opcional: aviso por WhatsApp al equipo (número 521XXXXXXXXXX y plantilla aprobada en Meta)
WA_TEAM_NUMBER=
WA_TEAM_TEMPLATE=
WA_TEAM_TEMPLATE_LANG=es_MX
# Asistente conversacional con IA (opcional). Sin clave se usa el menú guiado.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
